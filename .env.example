# hongik-docs 환경 변수 예시
# VitePress 정적 사이트라 빌드 시점에 필요한 변수만 있다.

# ────────────────────────────────────
# InlinePlayground가 호출할 백엔드 API
# ────────────────────────────────────

# `docs/.vitepress/theme/InlinePlayground.vue`에서 사용.
# 현재는 컴포넌트 안에서 'https://api.hong-ik.dev'가 하드코딩됨 — 추후 빌드 시점 주입 시 사용 예정.
VITE_API_BASE_URL=https://api.hong-ik.dev

# 빌드 환경 식별 (production일 때 sitemap 생성 등)
NODE_ENV=production
